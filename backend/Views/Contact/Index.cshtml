@inject CarTechShowcase.Services.SiteConfigService ConfigService
@{
    ViewData["Title"] = "Liên hệ";
    var cfg = await ConfigService.GetAsync();
    var phone = cfg.Phone ?? "0123-456-789";
    var phoneRaw = phone.Replace("-", "");
    var email = cfg.Email ?? "info@carscreen.vn";
    var address = cfg.Address ?? "123 Đường ABC, Quận 1, TP.HCM";
    var hoursWeekday = cfg.WorkingHoursWeekday ?? "Thứ 2 - Thứ 7: 8:00 - 20:00";
    var hoursSunday = cfg.WorkingHoursSunday ?? "Chủ nhật: 9:00 - 18:00";
    var zaloPhone = cfg.ZaloPhone ?? phoneRaw;
    var mapUrl = cfg.MapEmbedUrl ?? "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.4946345449366!2d106.69674841533424!3d10.762622492330086!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x317529292e8d303b%3A0xc48641e33e271c69!2zMTIzIMSQxrDhu51uZyBBQkMsIFF14bqjIEjGsMG7LCAoQjox2kFDRyk!5e0!3m2!1svi!2svn!4v1705123456789";
}

<div class="min-h-screen py-24">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold mb-4">
                Liên hệ <span class="text-gradient">với chúng tôi</span>
            </h1>
            <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                Để lại thông tin hoặc ghé thăm showroom để được tư vấn trực tiếp
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="mb-8 p-4 rounded-lg bg-green-900/30 text-green-400 text-center">
                @TempData["Success"]
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
            <!-- Contact Form -->
            <div class="glass-card border-border rounded-xl">
                <div class="p-8">
                    <h2 class="text-2xl font-bold mb-6">Gửi tin nhắn cho chúng tôi</h2>
                    <form method="post" action="/Contact/Send" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="block text-sm font-medium mb-2">Họ và tên <span class="text-primary">*</span></label>
                            <input required name="Name" placeholder="Nguyễn Văn A"
                                   class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Số điện thoại <span class="text-primary">*</span></label>
                            <input required type="tel" name="Phone" placeholder="0123456789"
                                   class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Email</label>
                            <input type="email" name="Email" placeholder="email@example.com"
                                   class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Nội dung <span class="text-primary">*</span></label>
                            <textarea required name="Message" rows="5" placeholder="Cho chúng tôi biết bạn quan tâm đến sản phẩm nào..."
                                      class="w-full px-4 py-2 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
                        </div>
                        <button type="submit" class="w-full px-6 py-3 bg-primary text-white rounded-lg text-lg glow-effect hover:opacity-90 transition-opacity inline-flex items-center justify-center">
                            <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
                            Gửi tin nhắn
                        </button>
                    </form>
                </div>
            </div>

            <!-- Contact Info -->
            <div>
                <div class="space-y-6 mb-8">
                    <!-- Address -->
                    <div class="glass-card border-border rounded-xl">
                        <div class="p-6">
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold mb-2">Địa chỉ</h3>
                                    <p class="text-muted-foreground">@address</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Phone -->
                    <div class="glass-card border-border rounded-xl">
                        <div class="p-6">
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold mb-2">Điện thoại</h3>
                                    <a href="tel:@phoneRaw" class="text-muted-foreground hover:text-primary transition-colors">@phone</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Email -->
                    <div class="glass-card border-border rounded-xl">
                        <div class="p-6">
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold mb-2">Email</h3>
                                    <a href="mailto:@email" class="text-muted-foreground hover:text-primary transition-colors">@email</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Hours -->
                    <div class="glass-card border-border rounded-xl">
                        <div class="p-6">
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold mb-2">Giờ làm việc</h3>
                                    <p class="text-muted-foreground">@hoursWeekday<br/>@hoursSunday</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Contact Buttons -->
                <div class="grid grid-cols-2 gap-4">
                    <a href="tel:@phoneRaw" class="inline-flex items-center justify-center px-6 py-3 border border-border rounded-lg hover:bg-secondary transition-colors">
                        <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Gọi ngay
                    </a>
                    <a href="https://zalo.me/@zaloPhone" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white rounded-lg hover:opacity-90 transition-opacity">
                        Chat Zalo
                    </a>
                </div>
            </div>
        </div>

        <!-- Map -->
        <div class="glass-card border-border rounded-xl overflow-hidden">
            <div class="aspect-video w-full">
                <iframe src="@mapUrl"
                        width="100%" height="100%" style="border:0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="CarScreen Pro Location"></iframe>
            </div>
        </div>
    </div>
</div>
