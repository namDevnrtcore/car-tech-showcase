@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var product = ViewBag.Product as dynamic;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<dynamic>;
}

<div class="min-h-screen py-24">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
            <a href="/" class="hover:text-primary transition-colors">Trang chủ</a>
            <span>/</span>
            <a href="/Products" class="hover:text-primary transition-colors">Sản phẩm</a>
            <span>/</span>
            <span class="text-foreground">@product.Name</span>
        </div>

        <a href="/Products" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors mb-6">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Quay lại danh sách sản phẩm
        </a>

        <!-- Main Product Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <!-- Images -->
            <div>
                <div id="mainImageWrap" class="aspect-square rounded-2xl overflow-hidden bg-white mb-4">
                    <img id="mainImage" src="@product.Images[0]" alt="@product.Name" class="w-full h-full object-cover" />
                </div>
                <div class="grid grid-cols-3 gap-4">
                    @{
                        var images = product.Images;
                        var imageCount = 0;
                        foreach (var img in images) { imageCount++; }
                    }
                    @for (int i = 0; i < imageCount; i++)
                    {
                        <button onclick="setMainImage('@images[i]', this)" class="aspect-square rounded-lg overflow-hidden bg-white border-2 @(i == 0 ? "border-primary scale-105" : "border-transparent") transition-all thumbnail-btn">
                            <img src="@images[i]" alt="Preview @(i+1)" class="w-full h-full object-cover" />
                        </button>
                    }
                </div>
            </div>

            <!-- Product Info -->
            <div>
                <h1 class="text-4xl font-bold mb-4">@product.Name</h1>

                <div class="flex items-center gap-4 mb-6">
                    <div class="flex items-center gap-1">
                        @for (int i = 0; i < 5; i++)
                        {
                            <svg class="w-5 h-5 @(i < (int)Math.Floor((double)product.Rating) ? "fill-primary text-primary" : "text-muted-foreground")" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        }
                        <span class="ml-2 text-sm text-muted-foreground">@product.Rating (@product.Reviews đánh giá)</span>
                    </div>
                    <span class="px-3 py-1 @(product.Status == "Còn hàng" ? "bg-green-900/30 text-green-400" : "bg-secondary text-muted-foreground") rounded-full text-sm font-medium">@product.Status</span>
                </div>

                <div class="mb-6">
                    <div class="text-4xl font-bold text-primary mb-2">@string.Format("{0:N0}đ", (long)product.Price)</div>
                    <p class="text-muted-foreground">@product.Description</p>
                </div>

                <!-- Quick Specs -->
                <div class="glass-card p-4 mb-6 rounded-xl">
                    <h3 class="font-semibold mb-3">Thông số nhanh</h3>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        @{
                            var specs = product.DetailedSpecs;
                            foreach (var key in specs.Keys)
                            {
                                <div><span class="text-muted-foreground">@key:</span><span class="ml-2 font-medium">@specs[key]</span></div>
                            }
                        }
                    </div>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col gap-3 mb-6">
                    <a href="/Contact" class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white rounded-lg text-lg glow-effect hover:opacity-90 transition-opacity">
                        <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Liên hệ đặt hàng
                    </a>
                    <button class="inline-flex items-center justify-center px-6 py-3 border border-border rounded-lg text-lg hover:bg-secondary transition-colors">
                        <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        Tư vấn qua Zalo
                    </button>
                    <a href="tel:0123456789" class="inline-flex items-center justify-center px-6 py-3 bg-secondary text-foreground rounded-lg text-lg hover:bg-muted transition-colors">
                        <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Gọi ngay: 0123-456-789
                    </a>
                </div>

                <!-- Guarantees -->
                <div class="grid grid-cols-3 gap-4">
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <p class="text-xs text-muted-foreground">Bảo hành 2 năm</p>
                    </div>
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="16" height="13" x="6" y="4" rx="2"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="m19 19-3-2"/><path d="m5 19 3-2"/><path d="M20 8v4"/><path d="M4 8v4"/></svg>
                        <p class="text-xs text-muted-foreground">Lắp đặt miễn phí</p>
                    </div>
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                        <p class="text-xs text-muted-foreground">Hỗ trợ 24/7</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs: Features / Specs / Reviews -->
        <div class="mb-16">
            <!-- Tab buttons -->
            <div class="grid w-full grid-cols-3 mb-8 bg-secondary rounded-lg p-1">
                <button onclick="showTab('features')" id="tab-features" class="tab-btn px-4 py-2 rounded-md text-sm font-medium bg-primary text-white transition-colors">Tính năng nổi bật</button>
                <button onclick="showTab('specs')" id="tab-specs" class="tab-btn px-4 py-2 rounded-md text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Thông số kỹ thuật</button>
                <button onclick="showTab('reviews')" id="tab-reviews" class="tab-btn px-4 py-2 rounded-md text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Đánh giá</button>
            </div>

            <!-- Features Tab -->
            <div id="panel-features" class="tab-panel space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (dynamic feature in product.ProductFeatures)
                    {
                        <div class="glass-card border-border rounded-xl p-6">
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                                    <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                </div>
                                <div><h3 class="font-semibold mb-2">@feature.Title</h3><p class="text-sm text-muted-foreground">@feature.Description</p></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Specs Tab -->
            <div id="panel-specs" class="tab-panel hidden">
                <div class="glass-card border-border rounded-xl p-6">
                    <div class="space-y-4">
                        @{
                            var detailedSpecs = product.DetailedSpecs;
                            foreach (var key in detailedSpecs.Keys)
                            {
                                <div class="flex justify-between py-3 border-b border-border last:border-0">
                                    <span class="font-medium capitalize">@key:</span>
                                    <span class="text-muted-foreground">@detailedSpecs[key]</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Reviews Tab -->
            <div id="panel-reviews" class="tab-panel hidden space-y-6">
                <div class="glass-card border-border rounded-xl p-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="flex gap-1">
                            @for (int i = 0; i < 5; i++) { <svg class="w-5 h-5 fill-primary text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> }
                        </div>
                        <span class="font-semibold">Anh Tuấn - Toyota Camry</span>
                    </div>
                    <p class="text-muted-foreground">Màn hình rất mượt, giao diện đẹp. Âm thanh chất lượng tốt. Đội ngũ lắp đặt chuyên nghiệp, tư vấn nhiệt tình. Rất hài lòng với sản phẩm!</p>
                </div>
                <div class="glass-card border-border rounded-xl p-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="flex gap-1">
                            @for (int i = 0; i < 5; i++) { <svg class="w-5 h-5 fill-primary text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> }
                        </div>
                        <span class="font-semibold">Chị Hương - Honda CR-V</span>
                    </div>
                    <p class="text-muted-foreground">Sản phẩm chất lượng, giá cả hợp lý. Kết nối CarPlay rất tiện lợi. Camera lùi hiển thị rõ nét. Đã giới thiệu cho nhiều người bạn!</p>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <div>
            <h2 class="text-3xl font-bold mb-8">Sản phẩm <span class="text-gradient">liên quan</span></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @if (relatedProducts != null)
                {
                    foreach (var rp in relatedProducts)
                    {
                        <div class="hover-lift glass-card border-border overflow-hidden group">
                            <div class="aspect-square overflow-hidden bg-white">
                                <img src="@rp.Image" alt="@rp.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold mb-2">@rp.Name</h3>
                                <div class="flex items-center justify-between">
                                    <span class="text-lg font-bold text-primary">@string.Format("{0:N0}đ", (long)rp.Price)</span>
                                    <a href="/Products/Detail/@rp.Id" class="inline-flex items-center px-3 py-1 bg-primary text-white rounded-lg text-sm hover:opacity-90 transition-opacity">Xem</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setMainImage(src, btn) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumbnail-btn').forEach(function(b) {
                b.classList.remove('border-primary', 'scale-105');
                b.classList.add('border-transparent');
            });
            btn.classList.remove('border-transparent');
            btn.classList.add('border-primary', 'scale-105');
        }
        function showTab(name) {
            document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.add('hidden'); });
            document.querySelectorAll('.tab-btn').forEach(function(b) {
                b.classList.remove('bg-primary', 'text-white');
                b.classList.add('text-muted-foreground');
            });
            document.getElementById('panel-' + name).classList.remove('hidden');
            var btn = document.getElementById('tab-' + name);
            btn.classList.add('bg-primary', 'text-white');
            btn.classList.remove('text-muted-foreground');
        }
    </script>
}