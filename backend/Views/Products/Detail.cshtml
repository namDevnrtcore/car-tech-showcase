@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var product = ViewBag.Product as dynamic;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<dynamic>;
}

<div class="min-h-screen py-24">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
            <a href="/" class="hover:text-primary transition-colors">Trang chủ</a>
            <span>/</span>
            <a href="/Products" class="hover:text-primary transition-colors">Sản phẩm</a>
            <span>/</span>
            <span class="text-foreground">@product.Name</span>
        </div>

        <a href="/Products" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors mb-6">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Quay lại danh sách sản phẩm
        </a>

        <!-- Main Product Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <!-- Images -->
            <div>
                <div id="mainImageWrap" class="aspect-square rounded-2xl overflow-hidden bg-white mb-4">
                    <img id="mainImage" src="@product.Images[0]" alt="@product.Name" class="w-full h-full object-cover" />
                </div>
                <div class="grid grid-cols-3 gap-4">
                    @{
                        var images = product.Images;
                        var imageCount = 0;
                        foreach (var img in images) { imageCount++; }
                    }
                    @for (int i = 0; i < imageCount; i++)
                    {
                        <button onclick="setMainImage('@images[i]', this)" class="aspect-square rounded-lg overflow-hidden bg-white border-2 @(i == 0 ? "border-primary scale-105" : "border-transparent") transition-all thumbnail-btn">
                            <img src="@images[i]" alt="Preview @(i+1)" class="w-full h-full object-cover" />
                        </button>
                    }
                </div>
            </div>

            <!-- Product Info -->
            <div>
                <h1 class="text-4xl font-bold mb-4">@product.Name</h1>

                <div class="mb-2">
                    <span class="px-3 py-1 bg-green-900/30 text-green-400 rounded-full text-sm font-medium">@product.Status</span>
                </div>

                <div class="mb-6">
                    <div class="text-4xl font-bold text-primary mb-2">@string.Format("{0:N0}đ", (long)product.Price)</div>
                    <p class="text-muted-foreground">@product.Description</p>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col gap-3 mb-6">
                    <a href="/Order/@product.Id" class="inline-flex items-center justify-center px-6 py-4 bg-primary text-white rounded-xl text-lg font-bold glow-effect hover:opacity-90 active:scale-[0.98] transition-all">
                        <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Đặt hàng ngay
                    </a>
                    <div class="grid grid-cols-2 gap-3">
                        <a href="tel:0123456789" class="inline-flex items-center justify-center px-4 py-3 border border-border rounded-xl text-base hover:bg-secondary transition-colors">
                            <svg class="w-4 h-4 mr-2 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
                            Gọi ngay
                        </a>
                        <a href="/Contact" class="inline-flex items-center justify-center px-4 py-3 border border-border rounded-xl text-base hover:bg-secondary transition-colors">
                            <svg class="w-4 h-4 mr-2 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Tư vấn Zalo
                        </a>
                    </div>
                </div>

                <!-- Guarantees -->
                <div class="grid grid-cols-3 gap-4">
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <p class="text-xs text-muted-foreground">Bảo hành 2 năm</p>
                    </div>
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="16" height="13" x="6" y="4" rx="2"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="m19 19-3-2"/><path d="m5 19 3-2"/><path d="M20 8v4"/><path d="M4 8v4"/></svg>
                        <p class="text-xs text-muted-foreground">Lắp đặt miễn phí</p>
                    </div>
                    <div class="text-center p-3 glass-card rounded-lg">
                        <svg class="w-6 h-6 text-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                        <p class="text-xs text-muted-foreground">Hỗ trợ 24/7</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mô tả sản phẩm chi tiết -->
        @if (!string.IsNullOrEmpty((string)product.ContentHtml))
        {
            <div class="mb-16 glass-card border-border rounded-2xl p-8">
                <h2 class="text-2xl font-bold mb-6 pb-4 border-b border-border">Mô tả sản phẩm</h2>
                <div class="product-content prose-content">
                    @Html.Raw(product.ContentHtml)
                </div>
            </div>
        }

        <!-- Related Products -->
        <div>
            <h2 class="text-3xl font-bold mb-8">Sản phẩm <span class="text-gradient">liên quan</span></h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @if (relatedProducts != null)
                {
                    foreach (var rp in relatedProducts)
                    {
                        <div class="hover-lift glass-card border-border overflow-hidden group">
                            <div class="aspect-square overflow-hidden bg-white">
                                <img src="@rp.Image" alt="@rp.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold mb-2">@rp.Name</h3>
                                <div class="flex items-center justify-between">
                                    <span class="text-lg font-bold text-primary">@string.Format("{0:N0}đ", (long)rp.Price)</span>
                                    <a href="/Products/Detail/@rp.Id" class="inline-flex items-center px-3 py-1 bg-primary text-white rounded-lg text-sm hover:opacity-90 transition-opacity">Xem</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setMainImage(src, btn) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumbnail-btn').forEach(function(b) {
                b.classList.remove('border-primary', 'scale-105');
                b.classList.add('border-transparent');
            });
            btn.classList.remove('border-transparent');
            btn.classList.add('border-primary', 'scale-105');
        }
    </script>
    <style>
        .product-content { color: #d1d5db; line-height: 1.8; }
        .product-content h2 { font-size: 1.3em; font-weight: 700; color: #fff; margin: 1.5rem 0 0.75rem; }
        .product-content h3 { font-size: 1.1em; font-weight: 600; color: #fff; margin: 1.25rem 0 0.6rem; }
        .product-content p  { margin-bottom: 0.9rem; }
        .product-content ul, .product-content ol { padding-left: 1.4rem; margin-bottom: 0.9rem; }
        .product-content li { margin-bottom: 0.35rem; }
        .product-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9em; }
        .product-content td, .product-content th { border: 1px solid #333; padding: 8px 12px; }
        .product-content strong { color: #fff; font-weight: 600; }
        .product-content a { color: #ff6b00; }
    </style>
}