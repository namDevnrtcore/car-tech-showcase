@{
    ViewData["Title"] = "Trang chủ";
    var heroImage = ViewBag.HeroImage as string ?? "/images/hero-car-screen.jpg";
}

<div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative h-[90vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
            <img src="@heroImage" alt="Car Screen Hero" class="w-full h-full object-cover opacity-40" />
            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/50 to-transparent" />
        </div>
        <div class="container mx-auto px-4 relative z-10 text-center">
            <h1 class="text-5xl md:text-7xl font-bold mb-6">
                Nâng cấp trải nghiệm lái xe
                <br />
                <span class="text-gradient">với màn hình thông minh</span>
            </h1>
            <p class="text-xl md:text-2xl text-muted-foreground mb-8 max-w-2xl mx-auto">
                Công nghệ Android hiện đại, âm thanh sống động, lắp đặt chuyên nghiệp cho mọi dòng xe
            </p>
            <div class="flex gap-4 justify-center flex-wrap">
                <a href="/Products" class="inline-flex items-center px-8 py-3 bg-primary text-white rounded-lg text-lg glow-effect hover:opacity-90 transition-opacity">
                    Xem sản phẩm
                    <svg class="w-5 h-5 ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a href="/Contact" class="inline-flex items-center px-8 py-3 border border-border rounded-lg text-lg hover:bg-secondary transition-colors">Liên hệ tư vấn</a>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="py-16 container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @if (ViewBag.Features != null)
            {
                foreach (dynamic feature in ViewBag.Features)
                {
                    <div class="hover-lift glass-card border-border rounded-xl p-6 text-center">
                        <div class="mx-auto w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                @if (feature.Icon == "Shield") { <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/> }
                                @if (feature.Icon == "Headphones") { <path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/> }
                                @if (feature.Icon == "Check") { <polyline points="20 6 9 17 4 12"/> }
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">@feature.Title</h3>
                        <p class="text-muted-foreground text-sm">@feature.Description</p>
                    </div>
                }
            }
        </div>
    </section>

    <!-- About Section -->
    <section class="py-16 bg-card/50">
        <div class="container mx-auto px-4">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-4xl font-bold mb-6">
                    Chuyên gia <span class="text-gradient">màn hình ô tô</span>
                </h2>
                <p class="text-lg text-muted-foreground mb-8">
                    CarScreen Pro là đơn vị hàng đầu chuyên cung cấp màn hình Android cho ô tô với hơn 5 năm kinh nghiệm.
                    Chúng tôi cam kết mang đến sản phẩm chính hãng, chất lượng cao cùng dịch vụ lắp đặt chuyên nghiệp,
                    hỗ trợ kỹ thuật tận tâm.
                </p>
                <div class="flex justify-center gap-8 text-center">
                    <div>
                        <div class="text-4xl font-bold text-primary mb-2">5000+</div>
                        <div class="text-muted-foreground">Khách hàng</div>
                    </div>
                    <div>
                        <div class="text-4xl font-bold text-primary mb-2">100+</div>
                        <div class="text-muted-foreground">Dòng xe</div>
                    </div>
                    <div>
                        <div class="text-4xl font-bold text-primary mb-2">2 năm</div>
                        <div class="text-muted-foreground">Bảo hành</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories + Products Carousel -->
    <section class="py-16 bg-card/50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold mb-4">
                    Danh mục <span class="text-gradient">sản phẩm</span>
                </h2>
            </div>

            @if (ViewBag.Categories != null)
            {
                int catIdx = 0;
                foreach (dynamic category in ViewBag.Categories)
                {
                    string trackId = $"cat-track-{catIdx}";
                    var products = (IEnumerable<dynamic>)category.Products;
                    int count = 0;
                    foreach (var _ in products) count++;

                    <div class="mb-16">
                        <div class="flex items-center gap-4 mb-8">
                            <span class="text-4xl">@category.Icon</span>
                            <div><h3 class="text-2xl font-bold">@category.Name</h3></div>
                            <div class="ml-auto flex items-center gap-3">
                                <!-- Manual prev/next -->
                                <button onclick="carouselStep('@trackId', @count, -1)"
                                        class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-muted hover:text-white hover:border-primary transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                                </button>
                                <button onclick="carouselStep('@trackId', @count, 1)"
                                        class="w-8 h-8 rounded-full border border-border flex items-center justify-center text-muted hover:text-white hover:border-primary transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
                                </button>
                                <a href="/Products" class="inline-flex items-center px-4 py-2 border border-border rounded-lg text-sm hover:bg-secondary transition-colors">
                                    Xem tất cả
                                    <svg class="w-4 h-4 ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                </a>
                            </div>
                        </div>

                        <!-- Carousel -->
                        <div class="overflow-hidden">
                            <div id="@trackId" class="flex gap-6" style="transition:transform 0.7s cubic-bezier(.4,0,.2,1);will-change:transform">
                                @foreach (dynamic product in category.Products)
                                {
                                    <!-- Original cards -->
                                    <div class="flex-none w-[calc(33.333%-16px)] min-w-[260px] hover-lift glass-card border-border rounded-xl overflow-hidden group">
                                        <div class="aspect-video overflow-hidden bg-white relative">
                                            <img src="@product.Image" alt="@product.Name"
                                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                        </div>
                                        <div class="p-5">
                                            <h4 class="text-base font-semibold mb-1 line-clamp-2 leading-snug">@product.Name</h4>
                                            <p class="text-xs text-muted-foreground mb-3 line-clamp-2">@product.Specs</p>
                                            <div class="flex items-center justify-between">
                                                <span class="text-lg font-bold text-primary">@product.Price</span>
                                                <a href="/Products/Detail/@product.Id" class="inline-flex items-center px-3 py-1.5 bg-primary text-white rounded-lg text-xs hover:opacity-90 transition-opacity">Xem chi tiết</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @foreach (dynamic product in category.Products)
                                {
                                    <!-- Clone cards for seamless loop -->
                                    <div class="flex-none w-[calc(33.333%-16px)] min-w-[260px] hover-lift glass-card border-border rounded-xl overflow-hidden group" aria-hidden="true">
                                        <div class="aspect-video overflow-hidden bg-white">
                                            <img src="@product.Image" alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                        </div>
                                        <div class="p-5">
                                            <h4 class="text-base font-semibold mb-1 line-clamp-2 leading-snug">@product.Name</h4>
                                            <p class="text-xs text-muted-foreground mb-3 line-clamp-2">@product.Specs</p>
                                            <div class="flex items-center justify-between">
                                                <span class="text-lg font-bold text-primary">@product.Price</span>
                                                <a href="/Products/Detail/@product.Id" class="inline-flex items-center px-3 py-1.5 bg-primary text-white rounded-lg text-xs hover:opacity-90 transition-opacity">Xem chi tiết</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="border-b border-border mt-10"></div>
                    </div>

                    catIdx++;
                }
            }
        </div>
    </section>

    <script>
    (function() {
        // carousels[trackId] = { pos, count, timer }
        const state = {};

        function getCardWidth(track) {
            const card = track.children[0];
            if (!card) return 0;
            const r = card.getBoundingClientRect();
            const gap = parseFloat(getComputedStyle(track).gap) || 24;
            return r.width + gap;
        }

        window.carouselStep = function(id, count, dir) {
            const s = state[id];
            if (!s) return;
            // Reset timer on manual click
            clearInterval(s.timer);
            applySlide(id, count, s.pos + dir);
            s.timer = setInterval(() => applySlide(id, count, state[id].pos + 1), 5000);
        };

        function applySlide(id, count, nextPos) {
            const track = document.getElementById(id);
            if (!track) return;
            const s = state[id];

            // Wrap pos within [0, count)
            if (nextPos >= count) {
                // Snap to 0 without animation then slide to 1
                track.style.transition = 'none';
                track.style.transform  = 'translateX(0)';
                s.pos = 0;
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    track.style.transition = 'transform 0.7s cubic-bezier(.4,0,.2,1)';
                    // Don't slide again immediately; next tick will advance
                }));
                return;
            }
            if (nextPos < 0) {
                nextPos = count - 1;
            }

            s.pos = nextPos;
            const offset = nextPos * getCardWidth(track);
            track.style.transition = 'transform 0.7s cubic-bezier(.4,0,.2,1)';
            track.style.transform  = `translateX(-${offset}px)`;
        }

        function initCarousel(id, count) {
            if (count < 1) return;
            state[id] = { pos: 0, count, timer: null };
            state[id].timer = setInterval(() => applySlide(id, count, state[id].pos + 1), 5000);
        }

        // Init all carousels after DOM ready
        document.addEventListener('DOMContentLoaded', function() {
            @if (ViewBag.Categories != null)
            {
                int idx2 = 0;
                foreach (dynamic cat2 in ViewBag.Categories)
                {
                    var prods2 = (IEnumerable<dynamic>)cat2.Products;
                    int cnt2 = 0; foreach (var _ in prods2) cnt2++;
                    @:initCarousel('cat-track-@idx2', @cnt2);
                    idx2++;
                }
            }
        });
    })();
    </script>

    <!-- Latest News -->
    <section class="py-16 bg-card/50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold mb-4">
                    Tin tức <span class="text-gradient">mới nhất</span>
                </h2>
                <p class="text-lg text-muted-foreground">Cập nhật công nghệ và xu hướng xe hơi</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @if (ViewBag.HomeNews != null)
                {
                    foreach (dynamic news in ViewBag.HomeNews)
                    {
                        <div class="hover-lift glass-card border-border rounded-xl overflow-hidden group cursor-pointer">
                            <div class="aspect-video overflow-hidden">
                                <img src="@news.Image" alt="@news.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            </div>
                            <div class="p-6">
                                <div class="flex items-center gap-2 mb-3">
                                    <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded-full font-medium">@news.Tag</span>
                                    <span class="text-xs text-muted-foreground">@news.Date</span>
                                </div>
                                <h3 class="font-semibold text-lg mb-2 line-clamp-2 group-hover:text-primary transition-colors">@news.Title</h3>
                                <p class="text-sm text-muted-foreground line-clamp-3">@news.Excerpt</p>
                                <div class="mt-4">
                                    <a href="/News" class="text-primary hover:opacity-80 text-sm font-medium inline-flex items-center">
                                        Đọc thêm
                                        <svg class="w-4 h-4 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="text-center mt-10">
                <a href="/News" class="inline-flex items-center px-8 py-3 border border-border rounded-lg text-lg hover:bg-secondary transition-colors">
                    Xem tất cả tin tức
                    <svg class="w-5 h-5 ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Compatible Cars -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold mb-4">
                    Xe <span class="text-gradient">tương thích</span>
                </h2>
                <p class="text-lg text-muted-foreground">Sản phẩm của chúng tôi hỗ trợ hầu hết các dòng xe phổ biến tại Việt Nam</p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                @if (ViewBag.CompatibleCars != null)
                {
                    foreach (dynamic car in ViewBag.CompatibleCars)
                    {
                        <div class="hover-lift glass-card border-border rounded-xl cursor-pointer group">
                            <div class="p-6 text-center">
                                <img src="@car.Img" alt="@car.Name" class="w-20 h-20 mx-auto mb-3 object-contain" />
                                <h4 class="font-semibold group-hover:text-primary transition-colors">@car.Name</h4>
                                <p class="text-xs text-muted-foreground mt-1 line-clamp-1">@car.Models</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>