@using CarTechShowcase.Models
@{
    var p     = ViewBag.Product as Product ?? new Product();
    long price = (long)(p.Price ?? 0);
}

<div class="min-h-screen py-24">
    <div class="container mx-auto px-4 max-w-5xl">

        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-8">
            <a href="/" class="hover:text-primary transition-colors">Trang chủ</a>
            <span>/</span>
            <a href="/Products" class="hover:text-primary transition-colors">Sản phẩm</a>
            <span>/</span>
            <a href="/Products/Detail/@p.Id" class="hover:text-primary transition-colors line-clamp-1 max-w-[200px]">@p.ProductName</a>
            <span>/</span>
            <span class="text-foreground">Đặt hàng</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">

            <!-- LEFT: Product card -->
            <div class="lg:col-span-2">
                <div class="glass-card border-border rounded-2xl overflow-hidden sticky top-28">
                    <div class="aspect-square overflow-hidden bg-white">
                        <img src="@(p.Img ?? "/images/product-1.jpg")" alt="@p.ProductName"
                             class="w-full h-full object-cover"
                             onerror="this.src='/images/product-1.jpg'" />
                    </div>
                    <div class="p-5">
                        <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-0.5 rounded-full">@p.Category</span>
                        <h2 class="text-base font-bold mt-2 mb-1 leading-snug">@p.ProductName</h2>
                        <p class="text-sm text-muted-foreground mb-3 line-clamp-2">@p.Spec</p>
                        <div class="text-2xl font-bold text-primary">@string.Format("{0:N0}đ", price)</div>
                    </div>
                    <!-- Guarantees -->
                    <div class="border-t border-border px-5 py-4 space-y-2">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            Bảo hành 2 năm chính hãng
                        </div>
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                            Lắp đặt miễn phí tận nơi
                        </div>
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
                            Hỗ trợ 24/7 sau mua hàng
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Order form -->
            <div class="lg:col-span-3">
                <div class="glass-card border-border rounded-2xl p-7">
                    <h1 class="text-2xl font-bold mb-1">Thông tin đặt hàng</h1>
                    <p class="text-sm text-muted-foreground mb-7">Điền thông tin bên dưới — chúng tôi sẽ liên hệ xác nhận trong vòng 15 phút.</p>

                    <form method="post" action="/Order/Submit" id="orderForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />

                        <!-- Full name -->
                        <div class="mb-5">
                            <label class="block text-sm font-medium mb-2">
                                Họ và tên <span class="text-primary">*</span>
                            </label>
                            <input type="text" name="fullName" required
                                   placeholder="Nguyễn Văn A"
                                   class="w-full px-4 py-3 bg-secondary border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
                        </div>

                        <!-- Phone -->
                        <div class="mb-5">
                            <label class="block text-sm font-medium mb-2">
                                Số điện thoại <span class="text-primary">*</span>
                            </label>
                            <input type="tel" name="phone" required
                                   placeholder="0901 234 567"
                                   pattern="[0-9]{9,11}"
                                   class="w-full px-4 py-3 bg-secondary border border-border rounded-xl text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-all" />
                        </div>

                        <!-- Quantity -->
                        <div class="mb-7">
                            <label class="block text-sm font-medium mb-2">Số lượng</label>
                            <div class="flex items-center gap-3">
                                <button type="button" onclick="changeQty(-1)"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl border border-border bg-secondary hover:bg-muted text-xl font-bold transition-colors">−</button>
                                <input type="number" name="quantity" id="qtyInput"
                                       value="1" min="1" max="10"
                                       oninput="updateSummary(parseInt(this.value)||1)"
                                       class="w-20 text-center py-2.5 bg-secondary border border-border rounded-xl text-foreground font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-primary" />
                                <button type="button" onclick="changeQty(1)"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl border border-border bg-secondary hover:bg-muted text-xl font-bold transition-colors">+</button>
                                <span class="text-sm text-muted-foreground ml-1">(tối đa 10)</span>
                            </div>
                        </div>

                        <!-- Order summary -->
                        <div class="bg-secondary rounded-xl p-5 mb-7 space-y-3">
                            <div class="flex justify-between text-sm">
                                <span class="text-muted-foreground">Đơn giá</span>
                                <span>@string.Format("{0:N0}đ", price)</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-muted-foreground">Số lượng</span>
                                <span id="summaryQty">1</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-muted-foreground">Phí lắp đặt</span>
                                <span class="text-green-400 font-medium">Miễn phí</span>
                            </div>
                            <div class="border-t border-border pt-3 flex justify-between items-center">
                                <span class="font-semibold">Tổng cộng</span>
                                <span class="text-primary text-xl font-bold" id="summaryTotal">@string.Format("{0:N0}đ", price)</span>
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="w-full bg-primary hover:opacity-90 active:scale-[0.98] text-white py-4 rounded-xl text-lg font-bold transition-all glow-effect flex items-center justify-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            Xác nhận đặt hàng
                        </button>

                        <p class="text-xs text-center text-muted-foreground mt-4">
                            Bằng cách đặt hàng, bạn đồng ý với chính sách bảo hành và đổi trả của chúng tôi.
                        </p>
                    </form>
                </div>

                <!-- Contact alternatives -->
                <div class="mt-4 grid grid-cols-2 gap-3">
                    <a href="tel:0123456789"
                       class="flex items-center justify-center gap-2 px-4 py-3 glass-card border-border rounded-xl text-sm hover:bg-secondary transition-colors">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
                        Gọi ngay đặt hàng
                    </a>
                    <a href="/Contact"
                       class="flex items-center justify-center gap-2 px-4 py-3 glass-card border-border rounded-xl text-sm hover:bg-secondary transition-colors">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        Tư vấn Zalo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var unitPrice = @price;

        function changeQty(delta) {
            var input = document.getElementById('qtyInput');
            var val   = Math.max(1, Math.min(10, (parseInt(input.value) || 1) + delta));
            input.value = val;
            updateSummary(val);
        }

        function updateSummary(qty) {
            qty = Math.max(1, Math.min(10, qty || 1));
            document.getElementById('summaryQty').textContent  = qty;
            document.getElementById('summaryTotal').textContent = (unitPrice * qty).toLocaleString('vi-VN') + 'đ';
        }
    </script>
}
