@using CarTechShowcase.Models
@model News

<div class="max-w-4xl">
    <div class="flex items-center gap-2 mb-5 text-sm">
        <a href="/Admin/News" class="text-muted hover:text-white transition-colors">Tin tức</a>
        <span class="text-border">›</span>
        <span class="text-white">Thêm bài viết</span>
    </div>

    <form method="post" action="/Admin/News/Create" class="space-y-4"
          onsubmit="if(typeof tinymce!=='undefined') tinymce.triggerSave()">
        @Html.AntiForgeryToken()

        <div class="card space-y-4">
            <h3 class="text-sm font-medium text-white border-b border-border pb-3">Nội dung bài viết</h3>

            <div>
                <label class="form-label">Tiêu đề</label>
                <input type="text" name="Title" value="@Model.Title"
                       placeholder="VD: Xu hướng màn hình Android 2025"
                       class="form-input" />
            </div>

            <!-- Ảnh bìa -->
            <div>
                <label class="form-label">Ảnh bìa</label>
                <div class="flex gap-3 items-start">
                    <div class="flex-1">
                        <div class="flex gap-2">
                            <input type="text" name="Img" id="imgInput" value="@Model.Img"
                                   placeholder="/images/..." class="form-input"
                                   oninput="document.getElementById('imgPreview').src=this.value||'/images/hero-car-screen.jpg'" />
                            <label class="btn-secondary cursor-pointer whitespace-nowrap">
                                Tải ảnh lên
                                <input type="file" accept="image/*" class="hidden" onchange="uploadImg(this)" />
                            </label>
                        </div>
                    </div>
                    <img id="imgPreview" src="@(Model.Img ?? "/images/hero-car-screen.jpg")"
                         class="w-24 h-16 rounded-lg object-cover bg-surface flex-shrink-0 border border-border"
                         onerror="this.src='/images/hero-car-screen.jpg'" />
                </div>
            </div>

            <div>
                <label class="form-label">Tóm tắt</label>
                <textarea name="Summary" rows="2"
                          placeholder="Mô tả ngắn gọn (hiển thị trên trang danh sách)..."
                          class="form-input resize-none">@Model.Summary</textarea>
            </div>

            <div>
                <label class="form-label">Nội dung bài viết</label>
                <textarea name="Content" id="newsContent">@Html.Raw(Model.Content)</textarea>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Đăng bài
            </button>
            <a href="/Admin/News" class="btn-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tinymce@5/tinymce.min.js"></script>
<script>
tinymce.init({
    selector: '#newsContent',
    base_url: 'https://cdn.jsdelivr.net/npm/tinymce@5',
    height: 500,
    menubar: true,
    plugins: 'lists link image table code fullscreen',
    toolbar: 'undo redo | formatselect | bold italic underline | forecolor backcolor | alignleft aligncenter alignright | bullist numlist | link image table | code fullscreen',
    skin: 'oxide-dark',
    content_css: 'dark',
    images_upload_handler: function(blobInfo, success, failure) {
        var fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        fetch('/Admin/News/UploadImage', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(d => { if (d.success) success(d.path); else failure(d.error); })
            .catch(() => failure('Upload thất bại'));
    }
});

async function uploadImg(input) {
    if (!input.files[0]) return;
    var fd = new FormData();
    fd.append('file', input.files[0]);
    var r = await fetch('/Admin/News/UploadImage', { method: 'POST', body: fd });
    var d = await r.json();
    if (d.success) {
        document.getElementById('imgInput').value = d.path;
        document.getElementById('imgPreview').src = d.path;
    } else {
        alert(d.error);
    }
}
</script>
}
