@using CarTechShowcase.Models
@model IEnumerable<News>

@{
    string search = ViewBag.Search ?? "";
}

<div class="flex items-center justify-between mb-5">
    <form method="get" action="/Admin/News" class="flex gap-2">
        <input type="text" name="search" value="@search" placeholder="Tìm bài viết..."
               class="form-input w-64 h-9 py-0" />
        <button type="submit" class="btn-secondary h-9 py-0">Lọc</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="/Admin/News" class="btn-secondary h-9 py-0">Xóa lọc</a>
        }
    </form>
    <a href="/Admin/News/Create" class="btn-primary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
        Thêm bài viết
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-border bg-white/[0.02]">
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-14">Ảnh</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted">Tiêu đề</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-28">Ngày tạo</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-24">Hiển thị</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-32">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="py-12 text-center text-muted text-sm">Không tìm thấy bài viết nào</td>
                </tr>
            }
            @foreach (var n in Model)
            {
                <tr class="table-row">
                    <td class="py-3 px-4">
                        <img src="@n.Img" alt="@n.Title"
                             class="w-12 h-9 rounded-lg object-cover bg-surface border border-border"
                             onerror="this.src='/images/hero-car-screen.jpg'" />
                    </td>
                    <td class="py-3 px-4">
                        <p class="font-medium text-white text-xs line-clamp-1">@n.Title</p>
                        <p class="text-muted text-[11px] mt-0.5 line-clamp-1">@n.Summary</p>
                    </td>
                    <td class="py-3 px-4 text-xs text-muted">@n.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="py-3 px-4">
                        <form method="post" action="/Admin/News/Toggle/@n.Id" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="relative inline-flex h-5 w-9 rounded-full transition-colors @(n.IsActive ? "bg-brand" : "bg-border")">
                                <span class="inline-block h-4 w-4 rounded-full bg-white shadow-sm transition-transform mt-0.5 @(n.IsActive ? "translate-x-4" : "translate-x-0.5")"></span>
                            </button>
                        </form>
                    </td>
                    <td class="py-3 px-4">
                        <div class="flex items-center gap-1.5">
                            <a href="/Admin/News/Edit/@n.Id"
                               class="inline-flex items-center gap-1 bg-white/5 hover:bg-white/10 text-gray-300 text-xs px-2.5 py-1.5 rounded-lg transition-colors">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>
                                Sửa
                            </a>
                            <form method="post" action="/Admin/News/Delete/@n.Id" onsubmit="return confirm('Xóa bài viết này?')" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-danger text-xs px-2.5 py-1.5">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="text-xs text-muted mt-3">Tổng: @Model.Count() bài viết</p>
