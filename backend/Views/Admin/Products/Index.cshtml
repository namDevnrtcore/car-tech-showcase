@using CarTechShowcase.Models
@model IEnumerable<Product>

@{
    string search    = ViewBag.Search ?? "";
    string category  = ViewBag.Category ?? "";
    string[] cats    = ViewBag.Categories as string[] ?? Array.Empty<string>();
}

<div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
        <!-- Search -->
        <form method="get" action="/Admin/Products" class="flex gap-2">
            <input type="text" name="search" value="@search" placeholder="Tìm sản phẩm..."
                   class="form-input w-52 h-9 py-0" />
            <select name="category" class="form-input w-48 h-9 py-0">
                <option value="">Tất cả danh mục</option>
                @foreach (var c in cats)
                {
                    <option value="@c" selected="@(c == category)">@c</option>
                }
            </select>
            <button type="submit" class="btn-secondary h-9 py-0">Lọc</button>
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(category))
            {
                <a href="/Admin/Products" class="btn-secondary h-9 py-0">Xóa lọc</a>
            }
        </form>
    </div>
    <a href="/Admin/Products/Create" class="btn-primary">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
        Thêm sản phẩm
    </a>
</div>

<div class="card p-0 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-border bg-white/[0.02]">
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-12">Ảnh</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted">Tên sản phẩm</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted">Danh mục</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted">Giá</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-24">Hiển thị</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-muted w-32">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="py-12 text-center text-muted text-sm">Không tìm thấy sản phẩm nào</td>
                </tr>
            }
            @foreach (var p in Model)
            {
                <tr class="table-row">
                    <td class="py-3 px-4">
                        <img src="@p.Img" alt="@p.ProductName"
                             class="w-10 h-10 rounded-lg object-cover bg-surface"
                             onerror="this.src='/images/product-1.jpg'" />
                    </td>
                    <td class="py-3 px-4">
                        <p class="font-medium text-white text-xs">@p.ProductName</p>
                        <p class="text-muted text-[11px] mt-0.5 line-clamp-1">@p.Spec</p>
                    </td>
                    <td class="py-3 px-4">
                        <span class="badge bg-brand/10 text-brand text-[11px]">@p.Category</span>
                    </td>
                    <td class="py-3 px-4 text-xs font-medium text-white">
                        @(p.Price.HasValue ? string.Format("{0:N0}", (long)p.Price.Value) + "đ" : "—")
                    </td>
                    <td class="py-3 px-4">
                        <form method="post" action="/Admin/Products/Toggle/@p.Id" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="relative inline-flex h-5 w-9 rounded-full transition-colors @(p.IsActive ? "bg-brand" : "bg-border")"
                                    title="@(p.IsActive ? "Đang hiển thị - nhấn để ẩn" : "Đang ẩn - nhấn để hiện")">
                                <span class="inline-block h-4 w-4 rounded-full bg-white shadow-sm transition-transform mt-0.5 @(p.IsActive ? "translate-x-4" : "translate-x-0.5")"></span>
                            </button>
                        </form>
                    </td>
                    <td class="py-3 px-4">
                        <div class="flex items-center gap-1.5">
                            <a href="/Admin/Products/Edit/@p.Id"
                               class="inline-flex items-center gap-1 bg-white/5 hover:bg-white/10 text-gray-300 text-xs px-2.5 py-1.5 rounded-lg transition-colors">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>
                                Sửa
                            </a>
                            <form method="post" action="/Admin/Products/Delete/@p.Id" onsubmit="return confirm('Xóa sản phẩm này?')" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-danger text-xs px-2.5 py-1.5">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="text-xs text-muted mt-3">Tổng: @Model.Count() sản phẩm</p>
