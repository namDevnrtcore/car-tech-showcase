@using CarTechShowcase.Models
@model SiteConfig

<div class="max-w-2xl">
    <form method="post" action="/Admin/Config" class="space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <!-- Thông tin công ty -->
        <div class="card space-y-4">
            <h3 class="text-sm font-semibold text-white border-b border-[#2a2a2a] pb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Thông tin công ty
            </h3>

            <div>
                <label class="form-label">Tên công ty / thương hiệu</label>
                <input type="text" name="CompanyName" value="@Model.CompanyName" class="form-input" placeholder="VinMap - Car Screen Pro" />
            </div>

            <div>
                <label class="form-label">Mô tả ngắn (hiển thị ở footer)</label>
                <textarea name="AboutShort" rows="2" class="form-input resize-none" placeholder="Chuyên cung cấp...">@Model.AboutShort</textarea>
            </div>
        </div>

        <!-- Liên hệ -->
        <div class="card space-y-4">
            <h3 class="text-sm font-semibold text-white border-b border-[#2a2a2a] pb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
                Thông tin liên hệ
            </h3>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" name="Phone" value="@Model.Phone" class="form-input" placeholder="0123-456-789" />
                </div>
                <div>
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" value="@Model.Email" class="form-input" placeholder="info@example.vn" />
                </div>
            </div>

            <div>
                <label class="form-label">Địa chỉ</label>
                <input type="text" name="Address" value="@Model.Address" class="form-input" placeholder="123 Đường ABC, Quận 1, TP.HCM" />
            </div>
        </div>

        <!-- Giờ làm việc -->
        <div class="card space-y-4">
            <h3 class="text-sm font-semibold text-white border-b border-[#2a2a2a] pb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Giờ làm việc
            </h3>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Thứ 2 — Thứ 7</label>
                    <input type="text" name="WorkingHoursWeekday" value="@Model.WorkingHoursWeekday" class="form-input" placeholder="Thứ 2 - Thứ 7: 8:00 - 20:00" />
                </div>
                <div>
                    <label class="form-label">Chủ nhật</label>
                    <input type="text" name="WorkingHoursSunday" value="@Model.WorkingHoursSunday" class="form-input" placeholder="Chủ nhật: 9:00 - 18:00" />
                </div>
            </div>
        </div>

        <!-- Mạng xã hội -->
        <div class="card space-y-4">
            <h3 class="text-sm font-semibold text-white border-b border-[#2a2a2a] pb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                Mạng xã hội & liên kết
            </h3>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Số Zalo (nút Chat Zalo)</label>
                    <input type="text" name="ZaloPhone" value="@Model.ZaloPhone" class="form-input" placeholder="0123456789" />
                    <p class="text-[11px] text-gray-600 mt-1">Link: zalo.me/<em>SốZalo</em></p>
                </div>
                <div>
                    <label class="form-label">Link Facebook</label>
                    <input type="url" name="FacebookUrl" value="@Model.FacebookUrl" class="form-input" placeholder="https://facebook.com/..." />
                </div>
            </div>
        </div>

        <!-- Google Maps -->
        <div class="card space-y-4">
            <h3 class="text-sm font-semibold text-white border-b border-[#2a2a2a] pb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Google Maps
            </h3>

            <div>
                <label class="form-label">Embed URL (src của iframe)</label>
                <textarea name="MapEmbedUrl" rows="3" class="form-input resize-none font-mono text-xs" placeholder="https://www.google.com/maps/embed?pb=...">@Model.MapEmbedUrl</textarea>
                <p class="text-[11px] text-gray-600 mt-1">
                    Lấy từ Google Maps → Chia sẻ → Nhúng bản đồ → Sao chép src trong thẻ &lt;iframe&gt;
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.MapEmbedUrl))
            {
                <div class="rounded-xl overflow-hidden border border-[#2a2a2a]" style="height:200px">
                    <iframe src="@Model.MapEmbedUrl" width="100%" height="200" style="border:0" loading="lazy"></iframe>
                </div>
            }
        </div>

        <!-- Save button -->
        <div class="flex gap-3">
            <button type="submit" class="btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Lưu cấu hình
            </button>
            <a href="/" target="_blank" class="btn-secondary">Xem trang chủ</a>
        </div>
    </form>
</div>
